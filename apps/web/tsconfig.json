{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"],
    "customConditions": ["development"],
    "paths": {
      "@/*": ["./src/*"],
      "@ol-types/*": ["./src/types/*"]
    }
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"]
}
